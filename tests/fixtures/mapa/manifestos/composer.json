{
  "name": "acme/app",
  "require": { "php": ">=8.1", "ext-json": "*", "laravel/framework": "^10.0" },
  "require-dev": { "phpunit/phpunit": "^10" },
  "autoload": { "psr-4": { "App\\": "app/" }, "classmap": ["database/seeds"] },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "test": "phpunit", "post-install-cmd": ["@php artisan key:generate", "@php artisan config:cache"] }
}
