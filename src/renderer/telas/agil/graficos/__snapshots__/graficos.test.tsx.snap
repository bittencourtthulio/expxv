exports[`mesma árvore, React e string idênticos > snapshot estável de um gráfico pequeno 1`] = `"<svg viewBox="0 0 640 92" class="svg-g" role="img" aria-labelledby="saude-t saude-d" preserveAspectRatio="xMidYMid meet" focusable="false"><title id="saude-t">Saúde da sprint</title><desc id="saude-d">Indicadores com cor, forma e frase.</desc><defs><pattern id="saude-p1" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="fl-1 fundo-padrao" width="6" height="6"></rect></pattern><pattern id="saude-p2" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="fl-2 fundo-padrao" width="6" height="6"></rect><path class="ln-2" d="M0 6L6 0" stroke-width="1.2"></path></pattern><pattern id="saude-p3" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="fl-3 fundo-padrao" width="6" height="6"></rect><circle class="fl-3 ponto-padrao" cx="3" cy="3" r="1"></circle></pattern><pattern id="saude-p4" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="fl-4 fundo-padrao" width="6" height="6"></rect><path class="ln-4" d="M0 3H6" stroke-width="1.2"></path></pattern><pattern id="saude-p5" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="fl-5 fundo-padrao" width="6" height="6"></rect><path class="ln-5" d="M3 0V6" stroke-width="1.2"></path></pattern><pattern id="saude-p6" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="fl-6 fundo-padrao" width="6" height="6"></rect><path class="ln-6" d="M0 0L6 6" stroke-width="1.2"></path></pattern></defs><g data-tip="Progresso dentro do ideal — restante 8 vs ideal 9" class="linha-saude"><circle cx="16" cy="18" r="6" class="st-verde"></circle><text class="rot txt" x="32" y="22">OK: Progresso dentro do ideal</text></g><g data-tip="Escopo cresceu 15 % — 3 pontos adicionados" class="linha-saude"><path d="M16 33L23 46H9Z" class="st-amarelo"></path><text class="rot txt" x="32" y="44">Atenção: Escopo cresceu 15 %</text></g><g data-tip="WIP acima do limite — 5 de 4" class="linha-saude"><rect x="10" y="56" width="12" height="12" class="st-vermelho"></rect><text class="rot txt" x="32" y="66">Alerta: WIP acima do limite</text></g></svg>"`;
