{
  "name": "expxv",
  "version": "0.1.0",
  "description": "ADE (Agentic Development Environment) do método Expx — macOS e Windows",
  "main": "dist/main/main.js",
  "private": true,
  "author": "Expx",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copiar-ativos.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "verificar": "node scripts/verificar.mjs",
    "dev": "node scripts/dev.mjs",
    "inicio": "npm run build && electron .",
    "perf": "node scripts/perf.mjs",
    "dist:dir": "npm run build && node scripts/dist-dir.mjs",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never --config electron-builder.yml",
    "icones": "node scripts/gerar-icones.mjs",
    "test:pacote": "node scripts/verificar-pacote.mjs",
    "postinstall": "node scripts/preparar-node-pty.mjs",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@xterm/headless": "6.0.0",
    "chokidar": "^5.0.0",
    "node-pty": "1.1.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.6.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
